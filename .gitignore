# Ignore CSV files everywhere EXCEPT in data/processed_3labels/
*.csv
!data/processed_3labels/*.csv

# Ignore JSON but allow specific files
*.json

# Ignore TXT files but allow requirements.txt
*.txt
!requirements.txt

# Database - Only ignore runtime database
*.db
*.sqlite
*.sqlite3
data/history.db

